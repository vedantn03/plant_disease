# Copy this file to .env and fill in your values.
# Never commit .env to git.

# Path to the PlantVillage "color" folder (38 class subfolders).
# Replace the placeholder with the absolute path to your local dataset.
# Example: DATA_ROOT=C:\path\to\plantvillage dataset\color
DATA_ROOT=<absolute-path-to-plantvillage-color-folder>

# MLflow tracking URI (default: SQLite file in project root)
# MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# Set to 1 to enable verbose debug logging
# DEBUG=0
