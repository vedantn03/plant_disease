{
  "id": null,
  "uid": "system-health-model-trust",
  "title": "System health and model trust",
  "tags": ["plant-disease", "monitoring"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "panels": [
    {
      "id": 1,
      "title": "Prediction request rate by status",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "sum by (status) (rate(predict_requests_total[5m]))", "legendFormat": "{{status}}"}
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
    },
    {
      "id": 2,
      "title": "Prediction latency p50 / p95",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "histogram_quantile(0.50, sum by (le, traffic_source) (rate(predict_latency_seconds_bucket[5m])))", "legendFormat": "p50 {{traffic_source}}"},
        {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le, traffic_source) (rate(predict_latency_seconds_bucket[5m])))", "legendFormat": "p95 {{traffic_source}}"}
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
    },
    {
      "id": 3,
      "title": "Confidence distribution (observations per second by bucket)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "sum by (le, traffic_source) (rate(predict_confidence_bucket[5m]))", "legendFormat": "le={{le}} {{traffic_source}}"}
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
    },
    {
      "id": 4,
      "title": "Uncertain / abstain requests by reason",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "sum by (reason) (increase(predict_abstain_total[5m]))", "legendFormat": "{{reason}}"}
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
    },
    {
      "id": 5,
      "title": "Serving model version and source",
      "type": "table",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "model_info", "format": "table", "instant": true}
      ],
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16}
    },
    {
      "id": 6,
      "title": "Provisional drift flag",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "drift_flag", "instant": true}
      ],
      "description": "No data means the exporter has insufficient data or no baseline.",
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 24}
    },
    {
      "id": 7,
      "title": "PSI by feature (provisional threshold)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "drift_psi", "legendFormat": "{{feature}}"}
      ],
      "gridPos": {"h": 6, "w": 9, "x": 6, "y": 24}
    },
    {
      "id": 8,
      "title": "Drift window size",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "drift_window_size"}
      ],
      "gridPos": {"h": 6, "w": 5, "x": 15, "y": 24}
    },
    {
      "id": 9,
      "title": "Replay share (staged traffic)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "drift_replay_share"}
      ],
      "gridPos": {"h": 6, "w": 4, "x": 20, "y": 24}
    }
  ]
}
